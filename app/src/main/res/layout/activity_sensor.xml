<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECRET SENSOR"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accelerometer dan Gyroscope"
            android:textColor="#666666"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- Accelerometer -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCELEROMETER"
                android:textColor="#1565C0"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStatusAccelerometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memeriksa sensor..."
                android:textSize="13sp"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/textAccelerometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menunggu data sensor..."
                android:textColor="#212121"
                android:textSize="17sp"
                android:lineSpacingExtra="8dp"
                android:paddingTop="12dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Gyroscope -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GYROSCOPE"
                android:textColor="#6A1B9A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStatusGyroscope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memeriksa sensor..."
                android:textSize="13sp"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/textGyroscope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menunggu data sensor..."
                android:textColor="#212121"
                android:textSize="17sp"
                android:lineSpacingExtra="8dp"
                android:paddingTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
